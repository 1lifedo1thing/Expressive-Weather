## keystore.properties example for Expressive Weather release signing
# Copy this file to keystore.properties (git-ignored) or provide the equivalent
# environment variables (KEYSTORE_PATH, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD).

storeFile=release-keystore.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=expressive-weather
keyPassword=CHANGE_ME_KEY_PASSWORD
