<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_mask"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Header + Current Temp -->
        <LinearLayout
            android:id="@+id/widget_radar_info_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_location_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_widget_location_24" />

                    <ImageView
                        android:id="@+id/widget_city_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:scaleType="fitStart" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_condition_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitStart" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_weather_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_fluent_weather_sunny_24" />

            <ImageView
                android:id="@+id/widget_current_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:scaleType="fitEnd" />
        </LinearLayout>

        <!-- Center: Large Material You Live Radar Map -->
        <FrameLayout
            android:id="@+id/widget_radar_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_radar_map_mask"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/widget_radar_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/widget_radar_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <!-- Bottom: 5 Individual Hourly Boxes -->
        <LinearLayout
            android:id="@+id/widget_hourly_tray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <FrameLayout android:id="@+id/hourly_col_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1">
                <ImageView android:id="@+id/hourly_box_bg_0" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/widget_hourly_box" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
                    <ImageView android:id="@+id/hourly_time_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_icon_0" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="2dp" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_temp_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout android:id="@+id/hourly_col_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1">
                <ImageView android:id="@+id/hourly_box_bg_1" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/widget_hourly_box" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
                    <ImageView android:id="@+id/hourly_time_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_icon_1" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="2dp" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_temp_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout android:id="@+id/hourly_col_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1">
                <ImageView android:id="@+id/hourly_box_bg_2" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/widget_hourly_box" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
                    <ImageView android:id="@+id/hourly_time_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_icon_2" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="2dp" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_temp_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout android:id="@+id/hourly_col_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1">
                <ImageView android:id="@+id/hourly_box_bg_3" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/widget_hourly_box" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
                    <ImageView android:id="@+id/hourly_time_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_icon_3" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="2dp" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_temp_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout android:id="@+id/hourly_col_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <ImageView android:id="@+id/hourly_box_bg_4" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/widget_hourly_box" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
                    <ImageView android:id="@+id/hourly_time_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_icon_4" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginTop="2dp" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_temp_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
