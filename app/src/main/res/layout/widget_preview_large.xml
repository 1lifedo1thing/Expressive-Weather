<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_material_you"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:layout_marginEnd="4dp" android:importantForAccessibility="no" android:src="@drawable/ic_widget_location_24" android:tint="@color/widget_my_text_primary" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="@string/widget_preview_city" android:textColor="@color/widget_my_text_primary" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:fontFamily="@font/google_sans_flex" android:text="17:30" android:textColor="@color/widget_my_text_secondary" android:textSize="11sp" />
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:alpha="0.82" android:importantForAccessibility="no" android:src="@drawable/ic_widget_settings_24" android:tint="@color/widget_my_text_primary" />
    </LinearLayout>

    <!-- Hero Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView android:layout_width="42dp" android:layout_height="42dp" android:importantForAccessibility="no" android:src="@drawable/ic_fluent_weather_sunny_24" android:tint="@color/widget_my_accent" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:fontFamily="@font/google_sans_flex" android:letterSpacing="-0.04" android:text="22°" android:textColor="@color/widget_my_text_primary" android:textSize="38sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="@string/widget_preview_sunny" android:textColor="@color/widget_my_text_primary" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="↑24° ↓15°" android:textColor="@color/widget_my_text_secondary" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 6 Individual Material You Rounded Hourly Boxes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_preview_my_box_active" android:gravity="center" android:orientation="vertical" android:paddingVertical="5dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="@string/widget_preview_now" android:textColor="@color/widget_my_on_primary_container" android:textSize="9.5sp" android:textStyle="bold" />
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_marginTop="2dp" android:importantForAccessibility="no" android:src="@drawable/ic_fluent_weather_sunny_24" android:tint="@color/widget_my_on_primary_container" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="22°" android:textColor="@color/widget_my_on_primary_container" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_preview_my_box_idle" android:gravity="center" android:orientation="vertical" android:paddingVertical="5dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="18:00" android:textColor="@color/widget_my_text_secondary" android:textSize="9.5sp" />
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_marginTop="2dp" android:importantForAccessibility="no" android:src="@drawable/ic_fluent_weather_partly_cloudy_day_24" android:tint="@color/widget_my_accent" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="23°" android:textColor="@color/widget_my_text_primary" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_preview_my_box_idle" android:gravity="center" android:orientation="vertical" android:paddingVertical="5dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="19:00" android:textColor="@color/widget_my_text_secondary" android:textSize="9.5sp" />
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_marginTop="2dp" android:importantForAccessibility="no" android:src="@drawable/ic_fluent_weather_rain_24" android:tint="@color/widget_my_accent" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="20°" android:textColor="@color/widget_my_text_primary" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_preview_my_box_idle" android:gravity="center" android:orientation="vertical" android:paddingVertical="5dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="20:00" android:textColor="@color/widget_my_text_secondary" android:textSize="9.5sp" />
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_marginTop="2dp" android:importantForAccessibility="no" android:src="@drawable/ic_fluent_weather_cloudy_24" android:tint="@color/widget_my_accent" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="19°" android:textColor="@color/widget_my_text_primary" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/widget_preview_my_box_idle" android:gravity="center" android:orientation="vertical" android:paddingVertical="5dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="21:00" android:textColor="@color/widget_my_text_secondary" android:textSize="9.5sp" />
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_marginTop="2dp" android:importantForAccessibility="no" android:src="@drawable/ic_fluent_weather_moon_24" android:tint="@color/widget_my_accent" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="18°" android:textColor="@color/widget_my_text_primary" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/widget_preview_my_box_idle" android:gravity="center" android:orientation="vertical" android:paddingVertical="5dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="22:00" android:textColor="@color/widget_my_text_secondary" android:textSize="9.5sp" />
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_marginTop="2dp" android:importantForAccessibility="no" android:src="@drawable/ic_fluent_weather_moon_24" android:tint="@color/widget_my_accent" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="17°" android:textColor="@color/widget_my_text_primary" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 7-Day Forecast Rows (Material You Rounded Range Line Bars + App Weather Icons) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="@string/widget_preview_d0" android:textColor="@color/widget_my_text_primary" android:textSize="11sp" android:textStyle="bold" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no" android:src="@drawable/ic_fluent_weather_sunny_24" android:tint="@color/widget_my_accent" />
            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:gravity="end" android:text="15" android:textColor="@color/widget_my_text_secondary" android:textSize="11sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="4dp" android:layout_marginHorizontal="8dp" android:layout_weight="1" android:background="@drawable/widget_preview_range_track" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="7" android:background="@drawable/widget_preview_range_pill" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            </LinearLayout>
            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="24" android:textColor="@color/widget_my_text_primary" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="@string/widget_preview_d1" android:textColor="@color/widget_my_text_primary" android:textSize="11sp" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no" android:src="@drawable/ic_fluent_weather_partly_cloudy_day_24" android:tint="@color/widget_my_accent" />
            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:gravity="end" android:text="14" android:textColor="@color/widget_my_text_secondary" android:textSize="11sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="4dp" android:layout_marginHorizontal="8dp" android:layout_weight="1" android:background="@drawable/widget_preview_range_track" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="6.5" android:background="@drawable/widget_preview_range_pill" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" />
            </LinearLayout>
            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="22" android:textColor="@color/widget_my_text_primary" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="@string/widget_preview_d2" android:textColor="@color/widget_my_text_primary" android:textSize="11sp" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no" android:src="@drawable/ic_fluent_weather_rain_24" android:tint="@color/widget_my_accent" />
            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:gravity="end" android:text="12" android:textColor="@color/widget_my_text_secondary" android:textSize="11sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="4dp" android:layout_marginHorizontal="8dp" android:layout_weight="1" android:background="@drawable/widget_preview_range_track" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.5" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="5.5" android:background="@drawable/widget_preview_range_pill" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="4" />
            </LinearLayout>
            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="18" android:textColor="@color/widget_my_text_primary" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="@string/widget_preview_d3" android:textColor="@color/widget_my_text_primary" android:textSize="11sp" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no" android:src="@drawable/ic_fluent_weather_cloudy_24" android:tint="@color/widget_my_accent" />
            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:gravity="end" android:text="13" android:textColor="@color/widget_my_text_secondary" android:textSize="11sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="4dp" android:layout_marginHorizontal="8dp" android:layout_weight="1" android:background="@drawable/widget_preview_range_track" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="6" android:background="@drawable/widget_preview_range_pill" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" />
            </LinearLayout>
            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="20" android:textColor="@color/widget_my_text_primary" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="@string/widget_preview_d4" android:textColor="@color/widget_my_text_primary" android:textSize="11sp" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no" android:src="@drawable/ic_fluent_weather_sunny_24" android:tint="@color/widget_my_accent" />
            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:gravity="end" android:text="14" android:textColor="@color/widget_my_text_secondary" android:textSize="11sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="4dp" android:layout_marginHorizontal="8dp" android:layout_weight="1" android:background="@drawable/widget_preview_range_track" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="7.5" android:background="@drawable/widget_preview_range_pill" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            </LinearLayout>
            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="23" android:textColor="@color/widget_my_text_primary" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="@string/widget_preview_d5" android:textColor="@color/widget_my_text_primary" android:textSize="11sp" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no" android:src="@drawable/ic_fluent_weather_sunny_24" android:tint="@color/widget_my_accent" />
            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:gravity="end" android:text="16" android:textColor="@color/widget_my_text_secondary" android:textSize="11sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="4dp" android:layout_marginHorizontal="8dp" android:layout_weight="1" android:background="@drawable/widget_preview_range_track" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2.5" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="7" android:background="@drawable/widget_preview_range_pill" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.5" />
            </LinearLayout>
            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="25" android:textColor="@color/widget_my_text_primary" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="@string/widget_preview_d6" android:textColor="@color/widget_my_text_primary" android:textSize="11sp" />
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:importantForAccessibility="no" android:src="@drawable/ic_fluent_weather_partly_cloudy_day_24" android:tint="@color/widget_my_accent" />
            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:gravity="end" android:text="15" android:textColor="@color/widget_my_text_secondary" android:textSize="11sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="4dp" android:layout_marginHorizontal="8dp" android:layout_weight="1" android:background="@drawable/widget_preview_range_track" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="6.5" android:background="@drawable/widget_preview_range_pill" />
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" />
            </LinearLayout>
            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:fontFamily="@font/google_sans_flex" android:text="23" android:textColor="@color/widget_my_text_primary" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
