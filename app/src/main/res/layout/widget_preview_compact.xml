<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_material_you"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: City -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_location_24"
            android:tint="@color/widget_my_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/google_sans_flex"
            android:maxLines="1"
            android:text="@string/widget_preview_city"
            android:textColor="@color/widget_my_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hero: Temp Left + Unified App Icon Right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/google_sans_flex"
            android:letterSpacing="-0.04"
            android:text="22°"
            android:textColor="@color/widget_my_text_primary"
            android:textSize="38sp" />

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_fluent_weather_sunny_24"
            android:tint="@color/widget_my_accent" />
    </LinearLayout>

    <!-- Footer: Condition Left + Hi/Lo Right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/google_sans_flex"
            android:maxLines="1"
            android:text="@string/widget_preview_sunny"
            android:textColor="@color/widget_my_text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_flex"
            android:maxLines="1"
            android:text="↑24° ↓15°"
            android:textColor="@color/widget_my_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
