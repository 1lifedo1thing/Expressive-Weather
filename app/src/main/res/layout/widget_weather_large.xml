<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_mask"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_location_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_location_24" />

            <ImageView
                android:id="@+id/widget_city_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:scaleType="fitStart" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="center_vertical|start">

                <ImageView
                    android:id="@+id/widget_updated_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:scaleType="fitStart" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_btn_settings"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:alpha="0.80"
                android:contentDescription="@string/widget_config_title"
                android:padding="2dp"
                android:src="@drawable/ic_widget_settings_24" />
        </LinearLayout>

        <!-- Hero Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_weather_icon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_fluent_weather_sunny_24" />

            <ImageView
                android:id="@+id/widget_current_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:scaleType="fitStart" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_condition_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:scaleType="fitEnd" />

                <ImageView
                    android:id="@+id/widget_high_low"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitEnd" />
            </LinearLayout>
        </LinearLayout>

        <!-- Individual Rounded Hourly Forecast Boxes (6 Columns, Matching App Screen) -->
        <LinearLayout
            android:id="@+id/widget_hourly_tray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/hourly_col_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/hourly_box_bg_0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_hourly_box" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <ImageView android:id="@+id/hourly_time_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_icon_0" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginTop="3dp" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_pop_0" android:layout_width="wrap_content" android:layout_height="12dp" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_temp_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/hourly_col_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/hourly_box_bg_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_hourly_box" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <ImageView android:id="@+id/hourly_time_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_icon_1" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginTop="3dp" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_pop_1" android:layout_width="wrap_content" android:layout_height="12dp" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_temp_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/hourly_col_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/hourly_box_bg_2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_hourly_box" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <ImageView android:id="@+id/hourly_time_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_icon_2" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginTop="3dp" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_pop_2" android:layout_width="wrap_content" android:layout_height="12dp" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_temp_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/hourly_col_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/hourly_box_bg_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_hourly_box" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <ImageView android:id="@+id/hourly_time_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_icon_3" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginTop="3dp" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_pop_3" android:layout_width="wrap_content" android:layout_height="12dp" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_temp_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/hourly_col_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/hourly_box_bg_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_hourly_box" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <ImageView android:id="@+id/hourly_time_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_icon_4" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginTop="3dp" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_pop_4" android:layout_width="wrap_content" android:layout_height="12dp" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_temp_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/hourly_col_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/hourly_box_bg_5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_hourly_box" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <ImageView android:id="@+id/hourly_time_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_icon_5" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginTop="3dp" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_pop_5" android:layout_width="wrap_content" android:layout_height="12dp" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                    <ImageView android:id="@+id/hourly_temp_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Minimalist Weekly Forecast (Hairline Divider + Direct Clean Rows) -->
        <LinearLayout
            android:id="@+id/widget_daily_tray"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_daily_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="4dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_pill_white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <LinearLayout android:id="@+id/daily_row_0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="center_vertical|start"><ImageView android:id="@+id/daily_day_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                    <LinearLayout android:layout_width="32dp" android:layout_height="wrap_content" android:gravity="center"><ImageView android:id="@+id/daily_icon_0" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" /></LinearLayout>
                    <LinearLayout android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center_vertical|end"><ImageView android:id="@+id/daily_min_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                    <ImageView android:id="@+id/daily_bar_0" android:layout_width="0dp" android:layout_height="6dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_weight="1" android:importantForAccessibility="no" android:scaleType="fitXY" />
                    <LinearLayout android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center_vertical|end"><ImageView android:id="@+id/daily_max_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/daily_row_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="center_vertical|start"><ImageView android:id="@+id/daily_day_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                    <LinearLayout android:layout_width="32dp" android:layout_height="wrap_content" android:gravity="center"><ImageView android:id="@+id/daily_icon_1" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" /></LinearLayout>
                    <LinearLayout android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center_vertical|end"><ImageView android:id="@+id/daily_min_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                    <ImageView android:id="@+id/daily_bar_1" android:layout_width="0dp" android:layout_height="6dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_weight="1" android:importantForAccessibility="no" android:scaleType="fitXY" />
                    <LinearLayout android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center_vertical|end"><ImageView android:id="@+id/daily_max_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/daily_row_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="center_vertical|start"><ImageView android:id="@+id/daily_day_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                    <LinearLayout android:layout_width="32dp" android:layout_height="wrap_content" android:gravity="center"><ImageView android:id="@+id/daily_icon_2" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" /></LinearLayout>
                    <LinearLayout android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center_vertical|end"><ImageView android:id="@+id/daily_min_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                    <ImageView android:id="@+id/daily_bar_2" android:layout_width="0dp" android:layout_height="6dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_weight="1" android:importantForAccessibility="no" android:scaleType="fitXY" />
                    <LinearLayout android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center_vertical|end"><ImageView android:id="@+id/daily_max_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/daily_row_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="center_vertical|start"><ImageView android:id="@+id/daily_day_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                    <LinearLayout android:layout_width="32dp" android:layout_height="wrap_content" android:gravity="center"><ImageView android:id="@+id/daily_icon_3" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" /></LinearLayout>
                    <LinearLayout android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center_vertical|end"><ImageView android:id="@+id/daily_min_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                    <ImageView android:id="@+id/daily_bar_3" android:layout_width="0dp" android:layout_height="6dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_weight="1" android:importantForAccessibility="no" android:scaleType="fitXY" />
                    <LinearLayout android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center_vertical|end"><ImageView android:id="@+id/daily_max_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/daily_row_4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="center_vertical|start"><ImageView android:id="@+id/daily_day_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                    <LinearLayout android:layout_width="32dp" android:layout_height="wrap_content" android:gravity="center"><ImageView android:id="@+id/daily_icon_4" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" /></LinearLayout>
                    <LinearLayout android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center_vertical|end"><ImageView android:id="@+id/daily_min_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                    <ImageView android:id="@+id/daily_bar_4" android:layout_width="0dp" android:layout_height="6dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_weight="1" android:importantForAccessibility="no" android:scaleType="fitXY" />
                    <LinearLayout android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center_vertical|end"><ImageView android:id="@+id/daily_max_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/daily_row_5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="center_vertical|start"><ImageView android:id="@+id/daily_day_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                    <LinearLayout android:layout_width="32dp" android:layout_height="wrap_content" android:gravity="center"><ImageView android:id="@+id/daily_icon_5" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" /></LinearLayout>
                    <LinearLayout android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center_vertical|end"><ImageView android:id="@+id/daily_min_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                    <ImageView android:id="@+id/daily_bar_5" android:layout_width="0dp" android:layout_height="6dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_weight="1" android:importantForAccessibility="no" android:scaleType="fitXY" />
                    <LinearLayout android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center_vertical|end"><ImageView android:id="@+id/daily_max_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/daily_row_6" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                    <LinearLayout android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="center_vertical|start"><ImageView android:id="@+id/daily_day_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                    <LinearLayout android:layout_width="32dp" android:layout_height="wrap_content" android:gravity="center"><ImageView android:id="@+id/daily_icon_6" android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" /></LinearLayout>
                    <LinearLayout android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center_vertical|end"><ImageView android:id="@+id/daily_min_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                    <ImageView android:id="@+id/daily_bar_6" android:layout_width="0dp" android:layout_height="6dp" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_weight="1" android:importantForAccessibility="no" android:scaleType="fitXY" />
                    <LinearLayout android:layout_width="28dp" android:layout_height="wrap_content" android:gravity="center_vertical|end"><ImageView android:id="@+id/daily_max_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" /></LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
