<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="148dp"
        android:layout_height="148dp"
        android:layout_gravity="center">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_shape_preview_bg" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="28dp"
            android:fontFamily="@font/google_sans_flex"
            android:letterSpacing="-0.04"
            android:text="15°"
            android:textColor="@color/widget_my_on_primary_container"
            android:textSize="38sp" />

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="28dp"
            android:layout_marginBottom="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_fluent_weather_sunny_24"
            android:tint="@color/widget_my_accent" />
    </FrameLayout>
</FrameLayout>
