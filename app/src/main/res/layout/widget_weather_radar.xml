<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_mask"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Left: Material You Styled Live Rain Radar Map (Tapping opens RadarDetailActivity) -->
        <FrameLayout
            android:id="@+id/widget_radar_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.32"
            android:background="@drawable/widget_radar_map_mask"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/widget_radar_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/widget_radar_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <!-- Right: Current Weather Summary + 3 Mini Hourly Boxes -->
        <LinearLayout
            android:id="@+id/widget_radar_info_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp">

            <!-- City Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_location_icon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_widget_location_24" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical|start">

                    <ImageView
                        android:id="@+id/widget_city_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:scaleType="fitStart" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hero: App Weather Icon + Google Sans Temp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_weather_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_fluent_weather_sunny_24" />

                <ImageView
                    android:id="@+id/widget_current_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitStart" />
            </LinearLayout>

            <!-- Condition + Hi/Lo -->
            <ImageView
                android:id="@+id/widget_condition_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:scaleType="fitStart" />

            <!-- Bottom: 3 Individual Mini Hourly Boxes -->
            <LinearLayout
                android:id="@+id/widget_hourly_tray"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:gravity="bottom"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/hourly_col_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/hourly_box_bg_0"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_hourly_box" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">

                        <ImageView android:id="@+id/hourly_time_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
                        <ImageView android:id="@+id/hourly_icon_0" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginTop="2dp" android:importantForAccessibility="no" />
                        <ImageView android:id="@+id/hourly_temp_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/hourly_col_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/hourly_box_bg_1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_hourly_box" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">

                        <ImageView android:id="@+id/hourly_time_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
                        <ImageView android:id="@+id/hourly_icon_1" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginTop="2dp" android:importantForAccessibility="no" />
                        <ImageView android:id="@+id/hourly_temp_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/hourly_col_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/hourly_box_bg_2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_hourly_box" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp">

                        <ImageView android:id="@+id/hourly_time_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no" />
                        <ImageView android:id="@+id/hourly_icon_2" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginTop="2dp" android:importantForAccessibility="no" />
                        <ImageView android:id="@+id/hourly_temp_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:importantForAccessibility="no" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
